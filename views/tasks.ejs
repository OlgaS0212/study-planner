<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Planner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="layout">

    <%- include("partials/sidebar") %>

    <main class="main-content">
      <div class="topbar">
  <form action="/logout" method="POST">
    <button type="submit" class="logout-button">
      Logga ut
    </button>
  </form>
</div>

  <h1>Uppgifter</h1>

<div class="task-page-card">

  <h2>Lägg till en uppgift</h2>

  <form class="task-form" action="/tasks" method="POST">
    <input
      type="text"
      name="title"
      placeholder="Uppgift"
    >

    <input
      type="text"
      name="deadline"
      placeholder="Deadline"
  
    >
    <select name="course_id" required>
  <option value="" disabled selected>Välj kurs</option>

  <% courses.forEach(course => { %>
    <option value="<%= course.id %>">
      <%= course.name %>
    </option>
  <% }) %>
</select>

    <button type="submit">Lägg till</button>
  </form>

  <h2>Mina uppgifter</h2>

  <div class="task-list">

  <% tasks.forEach(task => { %>
    <div class="task-list-item">
      <span><%= task.title %></span>
      <span><%= task.course_name %></span>
      <span><%= task.deadline || "" %></span>

      <a href="/tasks/<%= task.id %>/edit" class="edit-task-button">
        Redigera
      </a>

      <form action="/tasks/<%= task.id %>/delete" method="POST">
        <button type="submit" class="delete-task-button">
          Ta bort
        </button>
      </form>

      <form action="/tasks/<%= task.id %>/complete" method="POST">
        <button type="submit" class="complete-task-button">
          Klar
        </button>
      </form>

    </div>
  <% }) %>

</div>

</div>
</main>

  </div>
  <script src="/js/main.js"></script>

</body>
</html>
