<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Planner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="layout">

    <%- include("partials/sidebar") %>

    <main class="main-content">
  <h1>Uppgifter</h1>

<div class="task-page-card">

  <h2>Lägg till en uppgift</h2>

  <form class="task-form" action="/tasks" method="POST"></form>
    <input
      type="text"
      name="title"
      placeholder="Uppgift"
    >

    <input
      type="text"
      name="deadline"
      placeholder="Deadline"
  
    >

    <button type="submit">Lägg till</button>
  </form>

  <h2>Mina uppgifter</h2>

  <div class="task-list">
    <div class="task-list-item">
      <span>Exempeluppgift</span>
      <span>Fredag 12:00</span>
      <button type="button">Klar</button>
    </div>
  </div>

</div>
</main>

  </div>

</body>
</html>
