<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Planner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="landing-page">

  <header class="top-header">
    <div class="logo">
      <div class="logo-placeholder"></div>
      <span>Study Planner</span>
    </div>

    <nav class="top-nav">
      <a href="/">Hem</a>
      <a href="/courses">Kurser</a>
      <a href="#">Min Plan</a>
      <a href="/calendar">Kalender</a>
      <a href="/tasks">Uppgifter</a>
    </nav>

    <div class="header-actions">
      <span class="profile-icon">◯</span>
      <button class="login-button">Logga in</button>
    </div>
  </header>

  <main>

    <section class="hero">
      <div class="hero-image">
        Bild
      </div>

      <div class="hero-content">
        <h1>Planera dina studier</h1>

        <p>
          Organisera dina kurser, håll koll på dina framsteg och nå dina mål.
        </p>

        <h2>Planera smartare. Studera bättre.</h2>

        <div class="hero-buttons">
          <button class="primary-button">Kom igång</button>
          <button class="secondary-button">Så fungerar det</button>
        </div>
      </div>
    </section>

    <section class="courses-section">
      <div class="section-heading">
        <h2>Mina kurser</h2>
        <a href="#">Visa alla kurser →</a>
      </div>

      <div class="course-grid">

        <article class="course-card">
          <div class="course-image"></div>
          <h3>Kursnamn</h3>
          <p>Kort beskrivning av kursen i en eller två rader.</p>
        </article>

        <article class="course-card">
          <div class="course-image"></div>
          <h3>Kursnamn</h3>
          <p>Kort beskrivning av kursen i en eller två rader.</p>
        </article>

        <article class="course-card">
          <div class="course-image"></div>
          <h3>Kursnamn</h3>
          <p>Kort beskrivning av kursen i en eller två rader.</p>
        </article>

        <article class="course-card">
          <div class="course-image"></div>
          <h3>Kursnamn</h3>
          <p>Kort beskrivning av kursen i en eller två rader.</p>
        </article>

      </div>

      <button class="add-course-button">＋ Lägg till kurs</button>
    </section>

    <section class="features">
      <div class="feature-box">
        <h3>Planera</h3>
        <p>Skapa din plan och håll koll på viktiga deadlines.</p>
      </div>

      <div class="feature-box">
        <h3>Följa upp</h3>
        <p>Se dina framsteg och vad du kan förbättra.</p>
      </div>

      <div class="feature-box">
        <h3>Påminnelser</h3>
        <p>Få påminnelser om uppgifter och deadline.</p>
      </div>

      <div class="feature-box">
        <h3>Allt på ett ställe</h3>
        <p>Kurser, uppgifter och anteckningar alltid med dig.</p>
      </div>
    </section>

  </main>

  <footer class="footer">
    <div>
      <strong>Study Planner</strong>
    </div>

    <div>
      <strong>Länkar</strong>
      <p>Hem</p>
      <p>Kurser</p>
      <p>Min Plan</p>
      <p>Kalender</p>
      <p>Uppgifter</p>
    </div>

    <div>
      <strong>Om oss</strong>
      <p>Om Study Planner</p>
      <p>Kontakt</p>
      <p>Hjälp</p>
    </div>

    <div>
      <strong>Följa oss</strong>
      <p>Instagram · YouTube · Facebook</p>
    </div>
  </footer>

</body>
</html>
