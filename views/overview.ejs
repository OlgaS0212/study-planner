<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Planner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="layout">

    <%- include("partials/sidebar") %>

    <main class="main-content">
  <h1>Hej Emma!</h1>

  <div class="overview-grid">

    <div class="overview-card">
      <h2>Dagens uppgifter</h2>
      <p>Här kommer dagens uppgifter senare.</p>
    </div>

    <div class="overview-card">
      <h2>Denna veckan</h2>

      <div class="week-item">
        <span>Inlämning projektplan</span>
        <span>Idag 23:59</span>
      </div>

      <div class="week-item">
        <span>Prov Fysik</span>
        <span>Onsdag 8:00</span>
      </div>

      <div class="week-item">
        <span>Presentation Engelska</span>
        <span>Fredag 9:15</span>
      </div>
    </div>

    <div class="overview-card">
      <h2>Kommande aktiviteter</h2>
      <p>Här kommer aktiviteter senare.</p>
    </div>

    <div class="overview-card">
      <h2>Senast aktivitet</h2>
      <p>Här kommer senaste aktivitet senare.</p>
    </div>

  </div>
</main>
</div>

</body>
</html>
