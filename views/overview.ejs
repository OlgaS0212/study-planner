<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Planner</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <div class="layout">

    <%- include("partials/sidebar") %>

    <main class="main-content">

      <div class="overview-header">
        <h1>Hej Emma!</h1>

        <form action="/logout" method="POST">
          <button type="submit" class="logout-button">
            Logga ut
          </button>
        </form>
      </div>

      <div class="overview-grid">

        <div class="overview-card">
          <h2>Dagens uppgifter</h2>
          <p>Här kommer dagens uppgifter senare.</p>
        </div>

        <div class="overview-card">
          <h2>Denna veckan</h2>

          <div class="add-task-form">

            <input
              type="text"
              id="new-task-input"
              placeholder="Ny uppgift"
            >

            <input
              type="text"
              id="new-task-date"
              placeholder="Dag och tid"
            >

            <select id="new-task-course">
              <option value="" disabled selected>
                Välj kurs
              </option>

              <% courses.forEach(course => { %>
                <option value="<%= course.id %>">
                  <%= course.name %>
                </option>
              <% }) %>
            </select>

            <button id="add-task-button">
              Lägg till
            </button>

          </div>

          <div id="week-task-list">

            <% tasks.forEach(task => { %>

              <div class="week-item">
                <span><%= task.title %></span>
                <span><%= task.course_name %></span>
                <span><%= task.deadline || "" %></span>

                <button class="delete-task-button">
                  Ta bort
                </button>
              </div>

            <% }) %>

          </div>

        </div>

        <div class="overview-card">
          <h2>Kommande aktiviteter</h2>
          <p>Här kommer aktiviteter senare.</p>
        </div>

        <div class="overview-card">
          <h2>Senast aktivitet</h2>
          <p>Här kommer senaste aktivitet senare.</p>
        </div>

      </div>

    </main>

  </div>

  <script src="/js/main.js"></script>

</body>
</html>
